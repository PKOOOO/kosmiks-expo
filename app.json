{
  "expo": {
    "name": "Kosmiks",
    "slug": "servey",
    "version": "1.0.0",
    "scheme": "kosmiks",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#423120",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kosmiks.app",
          "enableGooglePay": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#423120"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "./plugins/with-stripe-android-fixes",
      "expo-image"
    ],
    "android": {
      "package": "com.kosmiks.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#423120"
      },
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "kosmiks"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kosmiks.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kosmiks uses your photo library so you can add photos of your salon.",
        "NSCameraUsageDescription": "Kosmiks uses the camera so you can take photos of your salon."
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e001f7f4-9117-4d83-b0d6-21bbe8b84511"
      }
    },
    "owner": "kpkk"
  }
}
